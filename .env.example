# ── Telegram Userbot credentials (from https://my.telegram.org) ───────────────
API_ID=
API_HASH=

# ── Telethon StringSession ────────────────────────────────────────────────────
# Leave empty on first run. The script will log in interactively, print the
# generated string, and exit. Paste the output here, then redeploy.
SESSION_STRING=

# ── Telegram Bot API credentials (from @BotFather) ───────────────────────────
# Used to send real-time alert messages to ALERT_CHAT_ID
BOT_TOKEN=
ALERT_CHAT_ID=

# ── Monitoring targets ────────────────────────────────────────────────────────
# Comma-separated list of group usernames or numeric IDs to watch
# Leave empty to monitor ALL groups/channels the account is in
# Example: SOURCE_GROUPS=-100123456789,some_group,another_group
SOURCE_GROUPS=

# Where to forward matching messages ("me" = Saved Messages)
TARGET_ACCOUNT=me

# ── Keyword filter ────────────────────────────────────────────────────────────
# Comma-separated keywords; matched with word boundaries (case-insensitive)
# Example: buy,sell,urgent,important
KEYWORDS=urgent,buy,sell,important
